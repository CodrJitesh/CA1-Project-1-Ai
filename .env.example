# Budget Agent — LLM lane config (same setup as cse476-agentic-ai).
# Copy to .env and fill in a key. NEVER commit .env.
#
# Pick your lane: groq | local | foundry
PROVIDER=groq

# ===== Groq. FREE. Course default. ====================================
# Get a free key at console.groq.com/keys
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
# (no MODEL line needed: this lane defaults to openai/gpt-oss-20b)

# ===== Ollama, local. FREE. NO KEY. ==================================
# set PROVIDER=local above, then:  ollama pull llama3.2

# ===== Microsoft Foundry. Needs Azure. ==============================
# set PROVIDER=foundry, then uncomment:
# AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project/openai/v1/
# AZURE_OPENAI_API_KEY=PASTE_YOUR_FOUNDRY_KEY_HERE
# MODEL=chat-demo
